page{background:#fff8e8;color:#40281c;font-family:-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,Arial,sans-serif;min-height:100%}.h5-button,.h5-input,text,view{box-sizing:border-box}.h5-button{background:transparent;border:0;color:inherit;font:inherit;line-height:normal;margin:0;padding:0}.h5-button::after{border:0}.page-shell{background:radial-gradient(circle at 18% 10%,rgba(255,218,101,.28),transparent 24%),radial-gradient(circle at 92% 4%,rgba(255,128,173,.16),transparent 24%),linear-gradient(180deg,#fff4d4,#fffaf3 42%,#fff7ee);min-height:100vh;padding:32rpx 28rpx 144rpx}.page-shell.cool{background:radial-gradient(circle at 12% 8%,rgba(158,221,210,.32),transparent 24%),radial-gradient(circle at 95% 10%,rgba(255,216,107,.18),transparent 22%),linear-gradient(180deg,#eaf8ef,#fffaf1 48%,#fff7ed)}.page-shell.blush{background:radial-gradient(circle at 15% 10%,rgba(255,177,205,.28),transparent 26%),radial-gradient(circle at 88% 12%,rgba(255,222,102,.22),transparent 22%),linear-gradient(180deg,#fff0f6,#fff9ee 52%,#fff7f0)}.safe-top{height:112rpx}.card{background:hsla(0,0%,100%,.88);border:2rpx solid rgba(255,225,177,.64);border-radius:32rpx;box-shadow:0 18rpx 48rpx rgba(155,102,32,.11)}.primary-btn{align-items:center;background:linear-gradient(135deg,#ff7aa5,#ff3f7c);border-radius:46rpx;box-shadow:0 16rpx 28rpx rgba(255,74,128,.28);color:#fff;display:flex;font-size:34rpx;font-weight:700;height:92rpx;justify-content:center;letter-spacing:2rpx;width:100%}.secondary-btn{align-items:center;background:#fff;border:2rpx solid #f3dfbf;border-radius:38rpx;box-shadow:0 10rpx 24rpx rgba(97,66,23,.08);color:#7a5b28;display:flex;font-size:28rpx;font-weight:700;height:76rpx;justify-content:center}.muted{color:#a38d78}.section-title{align-items:center;display:flex;font-size:31rpx;font-weight:800;justify-content:space-between;margin:34rpx 0 18rpx}.section-more{align-items:center;color:#9b7f64;display:flex;font-size:27rpx;font-weight:600;gap:8rpx}