.profile-page{padding-bottom:146rpx}.profile-card{align-items:center;background:hsla(0,0%,100%,.82);display:flex;margin:22rpx 0 28rpx;padding:28rpx}.profile-avatar{align-items:center;background:linear-gradient(180deg,#fff0c9,#d7f3e7);border-radius:50%;display:flex;font-size:70rpx;height:112rpx;justify-content:center;margin-right:24rpx;width:112rpx}.profile-info{display:flex;flex:1;flex-direction:column}.profile-name{color:#3d2a20;font-size:34rpx;font-weight:900}.profile-slogan{color:#8b7563;font-size:24rpx;margin-top:10rpx}.package-card{align-items:center;background:linear-gradient(135deg,#fff8d9,#fff 52%,#ffeaf1);display:flex;justify-content:space-between;margin-bottom:24rpx;padding:28rpx}.package-title{color:#86600d;display:block;font-size:30rpx;font-weight:900}.package-desc{color:#b48b41;display:block;font-size:23rpx;margin-top:8rpx}.package-btn{align-items:center;background:linear-gradient(135deg,#ff8bb3,#ff477f);border-radius:29rpx;color:#fff;display:flex;font-size:24rpx;font-weight:900;height:58rpx;justify-content:center;width:126rpx}.menu-list{padding:4rpx 24rpx}.menu-item{align-items:center;border-bottom:2rpx solid hsla(32,39%,85%,.58);display:flex;height:94rpx;justify-content:space-between}.menu-item:last-child{border-bottom:0}.menu-left,.menu-right{align-items:center;display:flex}.menu-icon{align-items:center;background:#f4fbf7;border-radius:14rpx;display:flex;font-size:26rpx;height:48rpx;justify-content:center;margin-right:18rpx;width:48rpx}.menu-title{color:#52392d;font-size:27rpx;font-weight:800}.menu-extra{color:#b49c83;font-size:22rpx;margin-right:10rpx}.menu-arrow{color:#b9a58f;font-size:38rpx}