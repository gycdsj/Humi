.history-page{background:radial-gradient(circle at 18% 6%,rgba(255,232,162,.34),transparent 22%),linear-gradient(180deg,#fff5d8,#fffaf2 48%,#fff7ee)}.history-tabs{display:flex;gap:22rpx;margin:34rpx 0 24rpx}.history-tab{align-items:center;background:#fff;border-radius:34rpx;box-shadow:0 12rpx 28rpx rgba(110,72,23,.08);color:#7f654e;display:flex;font-size:26rpx;font-weight:900;height:66rpx;justify-content:center;min-width:184rpx;padding:0 28rpx}.history-tab.is-active{background:linear-gradient(135deg,#ffd45a,#ffae2b);color:#fff}.search-card{align-items:center;background:hsla(0,0%,100%,.74);border-radius:30rpx;display:flex;height:86rpx;margin-bottom:22rpx;padding:0 28rpx}.search-icon{height:34rpx;margin-right:14rpx;width:34rpx}.search-input{color:#50372a;flex:1;font-size:26rpx;height:70rpx}.search-placeholder{color:#c2ad95}.history-list{padding:6rpx 20rpx}.history-item{align-items:center;border-bottom:2rpx solid hsla(34,57%,85%,.62);display:flex;min-height:116rpx}.history-item:last-child{border-bottom:0}.history-icon{background:linear-gradient(180deg,#bff3ff,#fff0b8);border-radius:50%;height:72rpx;margin-right:18rpx;width:72rpx}.history-main{flex:1;min-width:0}.history-title{color:#4d3528;display:block;font-size:28rpx;font-weight:900;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.history-meta{color:#a48c75;display:block;font-size:22rpx;margin-top:8rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.history-side{align-items:flex-end;display:flex;flex-direction:column;min-width:128rpx}.history-time{color:#b49d85;font-size:20rpx}.history-heart{height:34rpx;margin-top:12rpx;width:34rpx}.empty-history{color:#a18874;font-size:26rpx;padding:80rpx 20rpx;text-align:center}