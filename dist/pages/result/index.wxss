.result-page{padding-bottom:44rpx}.topic-head{align-items:center;display:flex;margin:22rpx 0 36rpx}.topic-avatar{align-items:center;background:#fff;border:8rpx solid hsla(0,0%,100%,.8);border-radius:50%;box-shadow:0 14rpx 32rpx rgba(112,77,33,.13);display:flex;font-size:72rpx;height:126rpx;justify-content:center;margin-right:24rpx;width:126rpx}.topic-main{flex:1}.topic-title-row{align-items:center;display:flex}.topic-title{color:#3b271d;font-size:44rpx;font-weight:900;margin-right:18rpx}.edit-chip{background:hsla(0,0%,100%,.78);border-radius:18rpx;color:#9c8064;font-size:22rpx;font-weight:700;padding:6rpx 14rpx}.topic-tags{display:flex;gap:12rpx;margin-top:18rpx}.topic-tag{background:hsla(0,0%,100%,.76);border-radius:18rpx;color:#8d765d;font-size:22rpx;font-weight:800;padding:10rpx 18rpx}.topic-tag--active{background:linear-gradient(135deg,#ffd66e,#ffb229);color:#744600}.result-card{background:#fffdf8;border:3rpx dashed #ffdca4;min-height:390rpx;overflow:hidden;padding:54rpx 56rpx 48rpx;position:relative;text-align:center}.version-badge{color:#d2b176;display:block;font-size:23rpx;font-weight:800;margin-bottom:78rpx}.rhyme-content{position:relative;z-index:1}.rhyme-line{color:#4b3024;display:block;font-size:36rpx;font-weight:800;line-height:1.6;margin-top:20rpx}.card-deco{bottom:10rpx;font-size:82rpx;position:absolute;right:28rpx}.version-arrow{align-items:center;background:#f9c04e;border-radius:50%;color:#fff;display:flex;font-size:40rpx;font-weight:800;height:44rpx;justify-content:center;position:absolute;top:50%;transform:translateY(-50%);width:44rpx}.version-arrow--left{left:-1rpx}.version-arrow--right{right:-1rpx}.song-card{margin-top:24rpx;padding:26rpx}.song-player{align-items:center;display:flex}.song-play{align-items:center;background:linear-gradient(135deg,#ffc14a,#ff7b9f);border-radius:50%;color:#fff;display:flex;font-size:28rpx;font-weight:900;height:82rpx;justify-content:center;margin-right:20rpx;width:82rpx}.song-info{display:flex;flex-direction:column}.song-title{font-size:30rpx;font-weight:900}.song-desc{color:#9b8370;font-size:23rpx;margin-top:8rpx}.lyrics-box{background:#fff8e8;border-radius:22rpx;margin-top:22rpx;padding:20rpx}.lyrics-line{color:#6a4d3a;display:block;font-size:26rpx;line-height:1.45;margin:10rpx 0}.action-row{display:flex;justify-content:space-around;margin:34rpx 0 28rpx}.action-item{align-items:center;color:#7b6351;display:flex;flex-direction:column;font-size:24rpx;font-weight:800;gap:10rpx}.action-icon{align-items:center;border-radius:50%;display:flex;font-size:34rpx;height:56rpx;justify-content:center;width:56rpx}.action-item.is-favorite{color:#ff477f}.action-item.is-favorite .action-icon{background:#ff477f;color:#fff}.tip-card{align-items:center;background:rgba(255,245,216,.86);border-radius:26rpx;display:flex;padding:24rpx 28rpx}.tip-star{font-size:34rpx;margin-right:18rpx}.tip-title{color:#8a5a00;display:block;font-size:26rpx;font-weight:900}.tip-text{color:#9a806a;display:block;font-size:23rpx;margin-top:6rpx}.empty-card{color:#9a806a;padding:60rpx;text-align:center}