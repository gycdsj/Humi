.detail-page{padding-bottom:54rpx}.detail-topic{align-items:center;display:flex;margin:18rpx 0 26rpx;padding:24rpx}.detail-topic__icon{background:linear-gradient(180deg,#dff8ff,#fff0c4);border-radius:50%;height:94rpx;margin-right:22rpx;width:94rpx}.detail-topic__title{color:#422b20;display:block;font-size:39rpx;font-weight:900}.detail-topic__meta{color:#9c846e;display:block;font-size:27rpx;margin-top:8rpx}.version-list{display:flex;flex-direction:column;gap:22rpx}.song-recall{margin-bottom:24rpx;padding:26rpx}.song-recall__title{color:#52392d;display:block;font-size:31rpx;font-weight:900;margin-bottom:20rpx}.song-recall__item{border-top:2rpx solid hsla(32,39%,85%,.58);display:flex;padding:22rpx 0}.song-recall__play{align-items:center;background:linear-gradient(135deg,#ffc14a,#ff7b9f);border-radius:50%;display:flex;flex:0 0 72rpx;height:72rpx;justify-content:center;margin-right:20rpx;width:72rpx}.song-recall__mark.is-play{border-bottom:14rpx solid transparent;border-left:22rpx solid #fff;border-top:14rpx solid transparent;height:0;margin-left:5rpx;width:0}.song-recall__mark.is-pause{border-left:7rpx solid #fff;border-right:7rpx solid #fff;height:28rpx;width:24rpx}.song-recall__main{flex:1;min-width:0}.song-recall__name{color:#4d3428;display:block;font-size:29rpx;font-weight:900}.song-recall__time{color:#a58d72;display:block;font-size:24rpx;margin-top:6rpx}.song-recall__lyrics{background:#fff8e9;border-radius:18rpx;margin-top:14rpx;padding:16rpx 18rpx}.song-recall__line{color:#5f4535;display:block;font-size:27rpx;font-weight:700;line-height:1.42;margin:6rpx 0}.version-card{padding:28rpx}.version-card.is-favorite{border-color:#ffb2ca;box-shadow:0 18rpx 44rpx rgba(255,87,137,.12)}.version-head{align-items:center;display:flex;justify-content:space-between;margin-bottom:22rpx}.version-title{color:#4d3428;font-size:31rpx;font-weight:900}.version-time{color:#b19b83;font-size:25rpx}.version-content{background:#fff8e9;border-radius:22rpx;padding:24rpx}.version-line{color:#4c3327;display:block;font-size:33rpx;font-weight:800;line-height:1.45;margin:8rpx 0}.version-actions{display:flex;gap:16rpx;margin-top:22rpx}.version-action{align-items:center;background:#fff4d5;border-radius:31rpx;color:#8b6736;display:flex;flex:1;font-size:24rpx;font-weight:800;height:62rpx;justify-content:center}.version-action--danger{background:#fff0f4;color:#ff477f}.empty-detail{color:#a18874;font-size:29rpx;padding:70rpx 20rpx;text-align:center}