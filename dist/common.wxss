.bottom-nav{background:hsla(0,0%,100%,.94);border:2rpx solid rgba(255,222,176,.72);border-radius:34rpx;bottom:22rpx;box-shadow:0 16rpx 42rpx rgba(104,68,24,.13);display:flex;height:112rpx;justify-content:space-around;left:22rpx;padding:14rpx 18rpx 12rpx;position:fixed;right:22rpx;z-index:20}.bottom-nav__item{align-items:center;color:#b3a08a;display:flex;flex:1;flex-direction:column;justify-content:center}.bottom-nav__icon{align-items:center;display:flex;height:48rpx;justify-content:center;width:48rpx}.bottom-nav__label{font-size:25rpx;font-weight:700;margin-top:6rpx}.bottom-nav__item.is-active{color:#d48700}.page-header{align-items:center;display:flex;height:72rpx;justify-content:space-between;margin-bottom:18rpx}.page-header__left{align-items:center;display:flex;min-width:0}.page-header__back{align-items:center;display:flex;height:48rpx;justify-content:center;margin-right:12rpx;width:48rpx}.page-header__back-icon{height:42rpx;width:42rpx}.page-header__title{color:#3b281d;font-size:39rpx;font-weight:900}.page-header__subtitle{color:#a58d72;font-size:25rpx;margin-top:4rpx}.quota-mask{align-items:center;background:rgba(38,34,29,.68);display:flex;inset:0;justify-content:center;padding:42rpx;position:fixed;z-index:50}.quota-modal{background:#fff;border-radius:42rpx;box-shadow:0 22rpx 80rpx rgba(0,0,0,.2);padding:52rpx 36rpx 34rpx;text-align:center;width:100%}.quota-modal--package{padding-top:42rpx}.quota-hero{height:156rpx;margin:0 auto 22rpx;width:156rpx}.quota-title{color:#4a3328;display:block;font-size:37rpx;font-weight:900}.quota-desc{color:#9b8371;display:block;font-size:27rpx;margin:18rpx 0 34rpx}.quota-packages{display:flex;gap:18rpx;margin-bottom:30rpx}.quota-package{align-items:center;border-radius:24rpx;display:flex;flex:1;flex-direction:column;font-size:29rpx;font-weight:800;gap:16rpx;height:170rpx;justify-content:center}.quota-package--warm{background:linear-gradient(180deg,#fff8df,#fff2c7)}.quota-package--pink{background:linear-gradient(180deg,#fff1f5,#ffe4eb)}.quota-price{color:#ff8f16;font-size:34rpx}.quota-primary{height:84rpx}.quota-secondary{color:#8b6b54;margin-top:18rpx}